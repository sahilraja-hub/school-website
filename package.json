{
  "name": "school-website-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Comprehensive School Management & Information Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "npm run dev --workspace=@school/web",
    "dev:api": "npm run dev --workspace=@school/api",
    "build": "turbo run build",
    "test": "turbo run test",
    "seed": "npm run seed --workspace=@school/api",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "packageManager": "npm@11.12.1",
  "devDependencies": {
    "turbo": "^2.4.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
