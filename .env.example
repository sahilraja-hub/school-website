# ========================================================
# School Platform Environment Configuration
# Never commit real secrets to source control.
# ========================================================

# General Node Environment (development | test | production)
NODE_ENV=development

# API Backend Configuration
PORT=5001
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000

# Database (MongoDB and PostgreSQL connection strings)
MONGODB_URI=mongodb://127.0.0.1:27017/school_portal
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/school_db?schema=public

# JWT Secrets (Minimum 32 random characters in production)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend Configuration
VITE_API_URL=/api/v1
VITE_APP_NAME="Oakridge International Academy"
